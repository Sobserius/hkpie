#!/usr/bin/env sh
# Lock the screen with a flat cream filler and a pie-style ring. ✿
set -u

LOCK_IMAGE="${HOME}/.local/share/backgrounds/kawaii-rice/hkpie-lock.png"
PIE_LOCKER="${HOME}/.local/bin/hkpie-i3lock"

# Regenerate on every lock so the clock and date are current.
if command -v python3 >/dev/null 2>&1; then
    python3 "$(dirname "$0")/make-lock.py" >/dev/null 2>&1 || true
fi

pie_lock() {
    if [ -f "$LOCK_IMAGE" ]; then
        set -- -i "$LOCK_IMAGE"
    else
        set -- -c EAE7AA
    fi

    # A fat butter ring, blush typing arcs, dark slab separators: the lock
    # screen's round indicator now echoes the pmenu pie slices. It is always
    # visible, so WRONG/CHECK text stays readable inside; the EN/RU hint lives
    # on the card instead of crowding the ring.
    exec "$PIE_LOCKER" -n -e -f "$@" \
        --indicator \
        --radius=104 \
        --ring-width=20 \
        --inside-color=F7F7F7FF \
        --ring-color=F6F098FF \
        --insidever-color=EAE7AAFF \
        --ringver-color=F0A090FF \
        --insidewrong-color=F0A090FF \
        --ringwrong-color=2E2B21FF \
        --line-color=2E2B21FF \
        --keyhl-color=F0A090FF \
        --bshl-color=C3AF8DFF \
        --separator-color=2E2B21FF \
        --verif-color=2E2B21FF \
        --wrong-color=2E2B21FF \
        --verif-size=24 \
        --wrong-size=24 \
        --verif-text=CHECK \
        --wrong-text=WRONG \
        --no-modkey-text \
        --ind-pos='w/2:h/2+330'
}

if [ -x "$PIE_LOCKER" ]; then
    pie_lock
fi

# Fallback: vanilla Gentoo i3lock keeps its circular unlock feedback.
if command -v i3lock >/dev/null 2>&1; then
    if [ -f "$LOCK_IMAGE" ]; then
        exec i3lock -n -e -f -i "$LOCK_IMAGE"
    fi
    exec i3lock -n -e -f -c EAE7AA
fi

# Fallback for systems using a display manager / logind instead of i3lock.
if command -v loginctl >/dev/null 2>&1; then
    exec loginctl lock-session
fi

printf 'rice-lock: no locker available (emerge x11-misc/i3lock with -g)\n' >&2
exit 1
