PMenu.borderWidth:      2
PMenu.borderColor:      #2E2B21
PMenu.topShadowColor:   #2E2B21
PMenu.bottomShadowColor: #2E2B21
PMenu.diameterWidth:    260
PMenu.shadowThickness:  0
PMenu.faceName:         xft:Fira Sans:style=Bold
PMenu.faceSize:         13
