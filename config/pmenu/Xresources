! hkpie-brutal · pmenu X resources ✿
! Modelled on the i3lock ring: paper centre, butter slices, blush active arc,
! deep ink line and separators. The hard offset slab comes from picom.
! Load with: xrdb -merge ~/.config/pmenu/Xresources

PMenu.centerColor:      #DFD3BE
PMenu.background:       #C9B99F
PMenu.foreground:       #1C1916
PMenu.activeBackground: #D96B5C
PMenu.activeForeground: #1C1916
! pmenu paints its 2px outer rim from these; shadowThickness 0 kills the bevel.
PMenu.borderWidth:      2
PMenu.borderColor:      #1C1916
PMenu.topShadowColor:   #1C1916
PMenu.bottomShadowColor: #1C1916
PMenu.diameterWidth:    260
PMenu.shadowThickness:  0
PMenu.faceName:         xft:Fira Sans:style=Bold
PMenu.faceSize:         13
