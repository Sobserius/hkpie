# hkpie default palette roles, sourced by install.sh.
# The editable copy is ~/.config/hkpie/palette.conf (role=#HEX only).

export RICE_BACKGROUND='#EAE7AA'
export RICE_SURFACE='#F7F7F7'
export RICE_HIGHLIGHT='#F6F098'
export RICE_ACCENT='#F0A090'
export RICE_FOREGROUND='#474333'
export RICE_OUTLINE='#474333'
export RICE_SHADOW='#2E2B21'
export RICE_MUTED='#C3AF8D'
export RICE_MUTED_DARK='#A79071'

export RICE_WALLPAPER_NAME='hkpiewallpaper.png'
export RICE_WALLPAPER_SRC="${HOME}/Pictures/hkpiewallpaper.png"
export RICE_WALLPAPER_DST="${HOME}/.local/share/backgrounds/kawaii-rice/hkpiewallpaper.png"
export RICE_WALLPAPER="${RICE_WALLPAPER:-${RICE_WALLPAPER_DST}}"
