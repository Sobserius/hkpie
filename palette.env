# Colors sampled from ~/Pictures/hkpiewallpaper.png
# Sourced by install.sh and the helper scripts. i3 has its own copy in config/i3/config.

export RICE_CREAM='#EAE7AA'   # dominant pale yellow-green background
export RICE_BUTTER='#F6F098'  # bright yellow highlight
export RICE_PAPER='#F7F7F7'   # white shine
export RICE_BLUSH='#F0A090'   # coral cheek blush
export RICE_TAN='#C3AF8D'     # warm tan
export RICE_MOCHA='#A79071'   # deeper warm tan
export RICE_INK='#474333'     # dark olive outline
export RICE_DEEP='#2E2B21'    # deepest outline / shadow

export RICE_WALLPAPER_NAME='hkpiewallpaper.png'
export RICE_WALLPAPER_SRC="${HOME}/Pictures/hkpiewallpaper.png"
export RICE_WALLPAPER_DST="${HOME}/.local/share/backgrounds/kawaii-rice/hkpiewallpaper.png"
export RICE_WALLPAPER="${RICE_WALLPAPER:-${RICE_WALLPAPER_DST}}"
