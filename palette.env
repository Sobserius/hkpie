# hkpie default palette roles, sourced by install.sh.
# The editable copy is ~/.config/hkpie/palette.conf (role=#HEX only).

export RICE_BACKGROUND='#FAF6EE'
export RICE_SURFACE='#DFD3BE'
export RICE_HIGHLIGHT='#C9B99F'
export RICE_ACCENT='#D96B5C'
export RICE_FOREGROUND='#2E2924'
export RICE_OUTLINE='#2E2924'
export RICE_SHADOW='#1C1916'
export RICE_MUTED='#B8A88E'
export RICE_MUTED_DARK='#7D705D'

export RICE_WALLPAPER_NAME='hkpie-wallpaper.jpeg'
export RICE_WALLPAPER_SRC="${HOME}/Pictures/hkpie-wallpaper.jpeg"
export RICE_WALLPAPER_DST="${HOME}/.local/share/backgrounds/kawaii-rice/hkpie-wallpaper.jpeg"
export RICE_WALLPAPER="${RICE_WALLPAPER:-${RICE_WALLPAPER_DST}}"
